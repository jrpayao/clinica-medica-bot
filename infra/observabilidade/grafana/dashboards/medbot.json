          "expr": "sum by (area) (rate(medbot_cache_total{resultado=\"acerto\"}[15m])) / sum by (area) (rate(medbot_cache_total{resultado=~\"acerto|falta\"}[15m]))",
          "legendFormat": "{{area}}",
          "range": true
