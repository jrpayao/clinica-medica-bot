    {
      "type": "stat",
      "id": 7,
      "title": "Custo de IA no período",
      "description": "Soma registrada no billing para o período escolhido no alto da tela.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "medbot-banco"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "medbot-banco"
          },
          "rawSql": "SELECT COALESCE(SUM(cost_usd), 0) AS custo FROM token_usage WHERE $__timeFilter(created_at)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 6,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "thresholds"
          },
          "decimals": 4,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
