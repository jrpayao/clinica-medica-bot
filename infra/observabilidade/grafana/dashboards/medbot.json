      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "table",
      "id": 5,
      "title": "Rotas mais lentas (95% das requisições, última hora; só rotas com uso)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "topk(8, histogram_quantile(0.95, sum by (le, handler, method) (rate(http_request_duration_seconds_bucket[1h]))) > 0)",
          "legendFormat": "{{method}} {{handler}}",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Tempo",
            "desc": true
          }
        ],
        "showHeader": true
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "handler": "Rota",
              "method": "Método",
              "Value": "Tempo"
            }
          }
        }
      ]
    },
