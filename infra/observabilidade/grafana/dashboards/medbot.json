    {
      "type": "table",
      "id": 13,
      "title": "Uso de IA por unidade (período escolhido)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "medbot-banco"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "medbot-banco"
          },
          "rawSql": "SELECT e.nome AS \"Unidade\", COUNT(t.id) AS \"Chamadas\", SUM(t.total_tokens) AS \"Tokens\", SUM(t.cost_usd) AS \"Custo (US$)\" FROM token_usage t JOIN estabelecimentos e ON e.id = t.estabelecimento_id WHERE $__timeFilter(t.created_at) GROUP BY e.nome ORDER BY 4 DESC, 2 DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 24,
        "h": 7
