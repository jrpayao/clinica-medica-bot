# ============================================================
# MedBot API — Variaveis de Ambiente
# Copie para .env e preencha os valores
# ============================================================

# App
DEBUG=true
APP_NAME=MedBot API

# Database (PostgreSQL + AsyncPG)
DATABASE_URL=postgresql+asyncpg://medbot:medbot@localhost:5432/medbot

# Redis
REDIS_URL=redis://localhost:6379/0

# Qdrant (Vector DB)
QDRANT_URL=http://localhost:6333

# Security / JWT
SECRET_KEY=mude-esta-chave-em-producao
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
ALLOWED_ORIGINS=["http://localhost:4200","http://localhost:4201"]

# OpenAI-compatible endpoint (OpenRouter ou Ollama local)
OPENROUTER_API_KEY=ollama
OPENROUTER_BASE_URL=http://localhost:11434/v1

# Modelos IA
MODEL_ECONOMICO=llama3.1:8b
MODEL_MEDICO=cniongolo/biomistral:latest
MODEL_PREMIUM=llama3.1:8b
MODEL_RAG=cniongolo/biomistral:latest

# Billing Limits
DAILY_LIMIT_USD=10.00
MONTHLY_LIMIT_USD=200.00
ALERT_THRESHOLD_PCT=80

# WhatsApp / Evolution API
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=
WHATSAPP_INSTANCE=medbot

# SMS / Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email / SendGrid
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Telemedicina (Jitsi Meet)
# meet.jit.si serve so para demonstracao: exige login para abrir a sala e corta chamadas embutidas em 5 minutos.
# Em producao, aponte para o seu servidor Jitsi e preencha APP_ID/APP_SECRET para exigir JWT nas salas.
JITSI_BASE_URL=https://meet.jit.si
JITSI_APP_ID=
JITSI_APP_SECRET=
# Endereco publico do portal do paciente (usado no link da teleconsulta)
PORTAL_URL=http://localhost:4200
